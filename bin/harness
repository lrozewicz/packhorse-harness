#!/usr/bin/env bash
# ============================================================================
#  harness - a single command to operate the whole stack.
#  Everything it does is a thin layer over `docker compose` in the app/ directory.
# ============================================================================
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$HERE"

DC=(docker compose)

# --- Git Bash / MSYS on Windows ---------------------------------------------
# 1. MSYS rewrites arguments that look like Unix paths ("/v1/messages"
#    -> "C:/Program Files/Git/v1/messages") - poison for the docker CLI.
# 2. MinTTY is not a terminal docker accepts as a TTY ("the input device
#    is not a TTY") - `winpty`, bundled with Git for Windows, fixes that.
case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW* | MSYS* | CYGWIN*) HARNESS_OS=windows ;;
  Darwin)                   HARNESS_OS=macos ;;
  *)                        HARNESS_OS=linux ;;
esac

TTYWRAP=()
if [ "$HARNESS_OS" = "windows" ]; then
  export MSYS_NO_PATHCONV=1
  export MSYS2_ARG_CONV_EXCL='*'
  if [ -t 0 ] && [ -t 1 ] && command -v winpty >/dev/null 2>&1; then TTYWRAP=(winpty); fi
fi

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_red=$'\033[31m'; c_green=$'\033[32m'; c_off=$'\033[0m'
say()  { printf '%s%s%s\n' "$c_bold" "$*" "$c_off"; }
info() { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }
die()  { printf '%s%s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }
ok()   { printf '%s%s%s\n' "$c_green" "$*" "$c_off"; }

# --- .env helpers ---------------------------------------------------------------
# Value of KEY in .env, without an inline "  # comment" (Compose strips those too).
env_file_value() {
  sed -n "s/^$1=//p" .env 2>/dev/null | tail -n 1 | sed 's/[[:space:]][[:space:]]*#.*$//; s/[[:space:]]*$//'
}

# A setting from the environment, else from .env, else the default.
env_setting() {
  local name="$1" default="$2" value
  value="${!name:-}"
  [ -n "$value" ] || value="$(env_file_value "$name")"
  printf '%s' "${value:-$default}"
}

# KEY=VALUE in .env (appended when missing); `cat >` keeps the file's permissions.
set_env_value() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp)"
  awk -v k="$key" -v v="$value" '
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' .env > "$tmp"
  cat "$tmp" > .env
  rm -f "$tmp"
}

ensure_env() {
  [ -f .env ] && return 0
  say "no .env - creating it from .env.example"
  cp .env.example .env
  chmod 600 .env 2>/dev/null || true
  set_env_value LITELLM_MASTER_KEY "sk-harness-$(head -c 12 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9')"
  info "platform settings are detected automatically; fill in the provider keys in .env"
}

# --- environment detection --------------------------------------------------------
# Runs before every compose command, so a .env copied from another machine, or a GPU
# added or removed later, does not leave a broken configuration behind. The results
# are exported for this run (the environment wins over .env in Compose) and written
# to .env, so that plain `docker compose ...` behaves the same.
#   HARNESS_AUTODETECT=0          leave .env exactly as it is
#   HARNESS_PLATFORM=linux|windows  force the platform overlay (default: auto)
#   HARNESS_GPU=on|off            force the GPU overlay (default: auto)
GPU_CACHE="generated/.gpu-probe"
DOCKER_ENGINE=""        # engine | desktop | unavailable
PLATFORM=""             # linux | windows
GPU_STATE=""            # yes | no | unknown
GPU_REASON=""
NEEDS_CLAUDE_REBUILD=0

detect_docker_engine() {
  local os
  os="$(docker info --format '{{.OperatingSystem}}' 2>/dev/null || true)"
  case "$os" in
    "")                 DOCKER_ENGINE=unavailable ;;
    *"Docker Desktop"*) DOCKER_ENGINE=desktop ;;
    *)                  DOCKER_ENGINE=engine ;;
  esac
}

detect_platform() {
  local forced
  forced="$(env_setting HARNESS_PLATFORM auto)"
  case "$forced" in
    linux | windows) PLATFORM="$forced" ;;
    *) if [ "$HARNESS_OS" = windows ]; then PLATFORM=windows; else PLATFORM=linux; fi ;;
  esac
}

# Starts a throw-away container with --gpus all: without a usable NVIDIA GPU the
# NVIDIA prestart hook fails right away. Uses an image that is already local, so
# nothing is pulled; the result is cached per Docker engine.
probe_gpu() {
  local image result=no engine_id
  for image in packhorse/router:local packhorse/claude:local ""; do
    [ -n "$image" ] && docker image inspect "$image" >/dev/null 2>&1 && break
  done
  [ -n "$image" ] || return 0
  docker run --rm --gpus all --entrypoint true "$image" >/dev/null 2>&1 && result=yes
  engine_id="$(docker info --format '{{.ID}}' 2>/dev/null || true)"
  printf '%s %s\n' "$result" "$engine_id" > "$GPU_CACHE" 2>/dev/null || true
  printf '%s' "$result"
}

gpu_from_cache() {
  local line engine_id
  [ -f "$GPU_CACHE" ] || return 0
  line="$(head -n 1 "$GPU_CACHE" 2>/dev/null)"
  engine_id="$(docker info --format '{{.ID}}' 2>/dev/null || true)"
  [ "${line#* }" = "$engine_id" ] && printf '%s' "${line%% *}"
  return 0
}

detect_gpu() {
  local result
  case "$(env_setting HARNESS_GPU auto)" in
    on)  GPU_STATE=yes; GPU_REASON="forced (HARNESS_GPU=on)"; return ;;
    off) GPU_STATE=no;  GPU_REASON="disabled (HARNESS_GPU=off)"; return ;;
  esac
  if ! command -v nvidia-smi >/dev/null 2>&1 && [ ! -e /dev/nvidia0 ]; then
    GPU_STATE=no; GPU_REASON="no NVIDIA driver on the host (nvidia-smi not found)"; return
  fi
  result="$(gpu_from_cache)"
  [ -n "$result" ] || result="$(probe_gpu)"
  case "$result" in
    yes) GPU_STATE=yes;     GPU_REASON="docker run --gpus all works" ;;
    no)  GPU_STATE=no;      GPU_REASON="NVIDIA driver found, but docker run --gpus all fails (nvidia-container-toolkit missing?)" ;;
    *)   GPU_STATE=unknown; GPU_REASON="not probed yet - needs a local image (built on the first run)" ;;
  esac
}

# Updates KEY in .env when the detected value differs; `rebuild` marks build args
# of the claude image (a change needs a rebuild).
sync_env_value() {
  local key="$1" value="$2" old
  old="$(env_file_value "$key")"
  [ "$old" = "$value" ] && grep -q "^${key}=" .env && return 0
  set_env_value "$key" "$value"
  info "updated .env: ${key}=${value}${old:+ (was: ${old})}"
  if [ "${3:-}" = rebuild ] && [ -n "$old" ]; then NEEDS_CLAUDE_REBUILD=1; fi
}

configure_environment() {
  [ "$(env_setting HARNESS_AUTODETECT 1)" = 1 ] || return 0
  detect_docker_engine
  [ "$DOCKER_ENGINE" = unavailable ] && return 0
  detect_platform
  detect_gpu

  local sep files key value gid
  if [ "$PLATFORM" = windows ]; then sep=';'; else sep=':'; fi
  files="docker-compose.yml${sep}docker-compose.${PLATFORM}.yml"
  if [ "$GPU_STATE" = yes ]; then
    files="${files}${sep}docker-compose.gpu.yml"
  elif [ "$GPU_STATE" = unknown ] && env_file_value COMPOSE_FILE | grep -q 'docker-compose.gpu.yml'; then
    files="${files}${sep}docker-compose.gpu.yml"      # not probed yet: keep what .env had
  fi
  export COMPOSE_FILE="$files" COMPOSE_PATH_SEPARATOR="$sep"

  [ -f .env ] || return 0
  sync_env_value COMPOSE_FILE "$files"
  sync_env_value COMPOSE_PATH_SEPARATOR "$sep"

  if [ "$HARNESS_OS" = windows ]; then
    # Compose on Windows needs C:/path, not the Git Bash form /c/path.
    for key in WORKSPACE_DIR HOST_DRIVE HOST_CLAUDE_DIR; do
      value="$(env_file_value "$key")"
      if [[ "$value" =~ ^/([a-zA-Z])(/.*)?$ ]]; then
        sync_env_value "$key" "${BASH_REMATCH[1]^^}:${BASH_REMATCH[2]:-/}"
      fi
    done
  else
    # UID/GID and the docker group are build args of the claude image.
    sync_env_value HOST_UID "$(id -u)" rebuild
    sync_env_value HOST_GID "$(id -g)" rebuild
    gid="$(getent group docker 2>/dev/null | cut -d: -f3 || true)"
    [ -z "$gid" ] || sync_env_value DOCKER_GID "$gid" rebuild
  fi
}

usage() {
  cat <<'TXT'
harness - Claude Code in a container with host access + your own models via LiteLLM

  ./bin/harness <command> [arguments]

Daily work
  claude [args...]   Claude Code session in the container (no args: TUI)
  shell              bash shell in the container (host access, sudo, docker)
  hostinfo           host overview as seen from the container (CPU/RAM/VRAM/disks)
  login              log in with an Anthropic subscription (/login in the container)

Services
  up                 builds (if needed) and starts router + LiteLLM
  down               stops the services
  restart            restarts the router and LiteLLM
  build [svc]        rebuilds the images
  status             service state + router health + model list
  logs [svc]         follows the logs (default: router)

Models
  regen              models.yaml -> generated/* (after every models.yaml change)
  models             lists the active external models
  test [id]          end-to-end model test via router -> LiteLLM -> provider
  ask <id> <prompt>  one-off question to a model via Claude Code

Other
  doctor             detected platform, Docker engine, GPU, overlays and .env values
  compose [args...]  raw `docker compose` in this directory
  clean              down + removes the login volume (careful!)
TXT
}

# The host Claude Code config (~/.claude) is always mounted - whether the container
# uses it is decided by HARNESS_INHERIT_HOST_CONFIG. Docker would create a missing
# directory as root, and then Claude Code on the host would have nowhere to write.
ensure_host_claude_dir() {
  [ "$HARNESS_OS" = "windows" ] && return 0
  local dir
  dir="$(sed -n 's/^HOST_CLAUDE_DIR=//p' .env 2>/dev/null | tail -n 1)"
  dir="${dir:-$HOME/.claude}"
  [ -d "$dir" ] || mkdir -p "$dir"
}

# The Claude Code image is built only on first use (`up` starts the services).
# --- auto-stop -----------------------------------------------------------------
# `compose run claude` starts LiteLLM and the router on its own (depends_on). If a
# session started them, they are stopped again when the last session ends. Services
# started explicitly with `up`/`restart` are left running. HARNESS_AUTO_STOP=0 (env or
# .env) turns this off.
AUTOSTART_MARKER="generated/.autostarted"

services_running() {
  "${DC[@]}" ps --services --filter status=running 2>/dev/null | grep -qx router
}

# Name of this session's container, so that a container still shutting down after
# Ctrl+C or a closed terminal is not mistaken for another session.
SESSION_CONTAINER="packhorse-claude-$$-$(date +%s)"

other_sessions_running() {
  local project
  project="$("${DC[@]}" config 2>/dev/null | sed -n 's/^name: //p' | head -n 1)"
  docker ps --format '{{.Names}}' --filter "label=com.docker.compose.project=${project:-packhorse}" \
    --filter label=com.docker.compose.service=claude 2>/dev/null | grep -vxF "$SESSION_CONTAINER" | grep -q .
}

AUTO_STOP_DONE=0
auto_stop() {
  [ "$AUTO_STOP_DONE" = 1 ] && return 0
  AUTO_STOP_DONE=1
  [ "$(env_setting HARNESS_AUTO_STOP 1)" = 1 ] || return 0
  [ -f "$AUTOSTART_MARKER" ] || return 0
  if other_sessions_running; then
    info "other sessions are still running - leaving the services up"
    return 0
  fi
  info "last session ended - stopping LiteLLM and the router (HARNESS_AUTO_STOP=0 keeps them running)"
  "${DC[@]}" stop litellm router >/dev/null 2>&1 || true
  rm -f "$AUTOSTART_MARKER"
}

compose_run_claude() {
  ensure_host_claude_dir
  # Both images must exist before `compose run`: for the services it starts via
  # depends_on (harness-init, router) compose pulls a missing image instead of
  # building it - and packhorse/* is not published anywhere.
  local missing=()
  docker image inspect packhorse/router:local >/dev/null 2>&1 || missing+=(router)
  docker image inspect packhorse/claude:local >/dev/null 2>&1 || missing+=(claude)
  if [ "$NEEDS_CLAUDE_REBUILD" = 1 ] && [[ " ${missing[*]} " != *" claude "* ]]; then
    info "HOST_UID/HOST_GID/DOCKER_GID changed - rebuilding the Claude Code image"
    missing+=(claude)
  fi
  if [ "${#missing[@]}" -gt 0 ]; then
    say "building the images: ${missing[*]}"
    "${DC[@]}" build "${missing[@]}"
  fi
  # On the very first run the GPU could not be probed before an image existed.
  [ "$GPU_STATE" != unknown ] || configure_environment
  # This session is about to start the services itself -> they may be stopped afterwards.
  services_running || touch "$AUTOSTART_MARKER"
  # Closing the terminal (HUP) or Ctrl+C still ends in auto_stop.
  trap 'auto_stop; exit 130' INT
  trap 'auto_stop; exit 129' HUP
  trap 'auto_stop; exit 143' TERM
  local rc=0
  if [ -t 0 ] && [ -t 1 ]; then
    # interactive (TUI, /login) - via winpty in Git Bash
    "${TTYWRAP[@]}" "${DC[@]}" run --rm --quiet-pull --name "$SESSION_CONTAINER" claude "$@" || rc=$?
  else
    # piped (`echo ... | harness claude -p`, CI) - no TTY allocation
    "${DC[@]}" run --rm --quiet-pull -T --name "$SESSION_CONTAINER" claude "$@" || rc=$?
  fi
  trap - INT HUP TERM
  auto_stop
  return "$rc"
}

cmd_up() {
  # Explicitly started services are not stopped when a session ends.
  rm -f "$AUTOSTART_MARKER"
  say "starting services (harness-init -> litellm -> router)"
  "${DC[@]}" up -d --build router
  cmd_status
}

cmd_status() {
  say "services"
  "${DC[@]}" ps
  say "router /healthz"
  if "${DC[@]}" exec -T router node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>r.text()).then(t=>console.log(t))" 2>/dev/null; then :;
  else info "router is not responding (./bin/harness up)"; fi
}

cmd_models() {
  [ -f generated/registry.json ] || die "generated/registry.json is missing - ./bin/harness regen"
  if command -v jq >/dev/null 2>&1; then
    jq -r '"mode: \(.mode)\n", (.models[] | "\(.id)\n  label    : \(.label)\n  via      : \(.via)\n  api_base : \(.apiBase)\n  key      : \(.apiKeyEnv // "-")\n  ctx/out  : \(.contextTokens)/\(.maxOutputTokens)\n  mimics   : \(.behavesAs)\n")' generated/registry.json
  else
    cat generated/registry.json
  fi
}

cmd_regen() {
  say "regenerating the configuration from models.yaml"
  # --build: changes in router/src (the generator) must take effect without a manual `build`
  "${DC[@]}" run --rm --build --quiet-pull harness-init
  if "${DC[@]}" ps --services --filter status=running | grep -qx router; then
    # LiteLLM reads its config only on startup, and .env changes require
    # recreating the container - hence `up -d --force-recreate`, not `restart`.
    info "recreating LiteLLM and the router with the new configuration"
    "${DC[@]}" up -d --force-recreate --wait litellm router >/dev/null
  fi
  ok "done"
}

# End-to-end test: router -> LiteLLM -> provider, over the Anthropic Messages protocol.
cmd_test() {
  local model="${1:-}"
  if [ -z "$model" ]; then
    model="$(jq -r '.models[0].id' generated/registry.json 2>/dev/null || true)"
    [ -n "$model" ] && [ "$model" != "null" ] || die "specify a model id: ./bin/harness test <id>"
  fi
  say "testing /v1/messages via router: ${model}"
  "${DC[@]}" exec -T router node -e '
    const model = process.argv[1];
    const body = { model, max_tokens: 1024, messages: [{ role: "user", content: "Reply with exactly: HARNESS-OK" }] };
    fetch("http://127.0.0.1:8787/v1/messages", {
      method: "POST",
      headers: { "content-type": "application/json", "x-api-key": "test", "anthropic-version": "2023-06-01" },
      body: JSON.stringify(body)
    }).then(async (r) => {
      const data = await r.text();
      console.log("HTTP", r.status);
      try {
        const json = JSON.parse(data);
        const text = (json.content || []).filter((b) => b.type === "text").map((b) => b.text).join("");
        console.log(text ? `reply: ${text.trim()}` : data.slice(0, 800));
        if (json.usage) console.log("usage:", JSON.stringify(json.usage));
        process.exit(r.ok ? 0 : 1);
      } catch { console.log(data.slice(0, 800)); process.exit(1); }
    }).catch((e) => { console.error("error:", e.message); process.exit(1); });
  ' "$model"
}

cmd_doctor() {
  [ -f .env ] || info "no .env yet - it is created by the first ./bin/harness claude or up"
  rm -f "$GPU_CACHE"       # always re-probe here
  configure_environment
  local row='  %-22s %s\n' images="" svc
  say "environment"
  printf "$row" "shell" "$HARNESS_OS ($(uname -s 2>/dev/null))"
  printf "$row" "docker engine" "$DOCKER_ENGINE ($(docker info --format '{{.OperatingSystem}}, {{.ServerVersion}}' 2>/dev/null || echo 'not reachable'))"
  printf "$row" "docker compose" "$(docker compose version --short 2>/dev/null || echo '?')"
  printf "$row" "platform overlay" "${PLATFORM:-?} (HARNESS_PLATFORM=$(env_setting HARNESS_PLATFORM auto))"
  printf "$row" "gpu" "${GPU_STATE:-?} - ${GPU_REASON:-autodetect off}"
  printf "$row" "COMPOSE_FILE" "${COMPOSE_FILE:-$(env_file_value COMPOSE_FILE)}"
  if [ "$HARNESS_OS" != windows ] && [ "$DOCKER_ENGINE" = desktop ]; then
    info "  note: Docker Desktop from a Linux shell - /host, /dev and /sys point at Docker Desktop's VM, not at this machine"
  fi
  say ".env"
  printf "$row" "HOST_UID/HOST_GID" "$(env_file_value HOST_UID)/$(env_file_value HOST_GID)"
  printf "$row" "DOCKER_GID" "$(env_file_value DOCKER_GID)"
  printf "$row" "WORKSPACE_DIR" "$(env_file_value WORKSPACE_DIR)"
  printf "$row" "auto-detect" "$(env_setting HARNESS_AUTODETECT 1)"
  printf "$row" "auto-stop" "$(env_setting HARNESS_AUTO_STOP 1)"
  printf "$row" "inherit host config" "$(env_setting HARNESS_INHERIT_HOST_CONFIG 1)"
  say "state"
  for svc in router claude; do
    docker image inspect "packhorse/${svc}:local" >/dev/null 2>&1 && images="${images}${svc} "
  done
  printf "$row" "images" "${images:-none (built on the first run)}"
  printf "$row" "running services" "$("${DC[@]}" ps --services --filter status=running 2>/dev/null | tr '\n' ' ')"
}

cmd_ask() {
  local model="${1:?specify a model id}"; shift
  [ "$#" -gt 0 ] || die "specify a question"
  compose_run_claude -p --model "$model" "$*"
}

main() {
  local cmd="${1:-help}"; shift || true
  # .env first (commands that start containers create it), then one detection pass.
  case "$cmd" in claude | shell | hostinfo | login | up | build | regen) ensure_env ;; esac
  case "$cmd" in
    help | -h | --help | doctor) ;;
    *) [ ! -f .env ] || configure_environment ;;
  esac
  case "$cmd" in
    claude)   compose_run_claude "$@" ;;
    shell)    compose_run_claude bash "$@" ;;
    hostinfo) compose_run_claude exec hostinfo ;;
    login)    info "in the session, type /login and finish logging in in the browser"; compose_run_claude ;;
    doctor)   cmd_doctor ;;
    up)       cmd_up ;;
    down)     rm -f "$AUTOSTART_MARKER"; "${DC[@]}" down "$@" ;;
    restart)  rm -f "$AUTOSTART_MARKER"; "${DC[@]}" up -d --force-recreate --wait litellm router ;;
    build)    "${DC[@]}" build "${@:-}" ;;
    status)   cmd_status ;;
    logs)     "${DC[@]}" logs -f --tail 100 "${@:-router}" ;;
    regen)    cmd_regen ;;
    models)   cmd_models ;;
    test)     cmd_test "$@" ;;
    ask)      cmd_ask "$@" ;;
    compose)  "${DC[@]}" "$@" ;;
    clean)    "${DC[@]}" down -v ;;
    help | -h | --help) usage ;;
    *) usage; die "unknown command: ${cmd}" ;;
  esac
}

main "$@"
