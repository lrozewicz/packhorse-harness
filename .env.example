# ============================================================================
#  Harness environment configuration. Copy to .env and fill in.
#     cp .env.example .env
#  (.env is in .gitignore - this is where you keep provider keys)
# ============================================================================

# --- platform ---------------------------------------------------------------
# Compose reads these two variables directly from .env, so the overlay also
# applies to plain `docker compose ...`, not just to ./bin/harness.
#
#   Linux / Docker CE inside a WSL2 distro (default):
COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml
COMPOSE_PATH_SEPARATOR=:
#
#   Windows - Docker Desktop + Git Bash (comment out the two lines above and
#   uncomment these two; ./bin/harness does this itself when it creates .env):
# COMPOSE_FILE=docker-compose.yml;docker-compose.windows.yml
# COMPOSE_PATH_SEPARATOR=;

# --- identity and directories -----------------------------------------------
# Host UID/GID: files created by Claude Code get the correct owner.
# On Windows leave 1000 - `id -u` in Git Bash returns a Windows identifier
# (e.g. 197609), and binds from drive C: have no POSIX permissions.
HOST_UID=1000
HOST_GID=1000
# GID of the `docker` group on the host:  getent group docker | cut -d: -f3
# Irrelevant on Windows (Docker Desktop exposes the socket differently).
DOCKER_GID=984
# Directory mounted as /workspace (where Claude Code works on your code).
# Linux:          /home/user/repos            or `..` (next to this repo)
# Windows:        C:/work/repos               <- FORWARD slashes, no spaces,
#                 NOT /c/work/... and NOT C:\work\... (Compose won't understand it);
#                 `..` also works on Windows - relative paths are resolved
#                 from the compose file's directory.
WORKSPACE_DIR=..
CONTAINER_WORKDIR=/workspace

# Windows ONLY: container time zone (on Linux it comes from /etc/localtime).
# TZ=Europe/Warsaw

# Windows ONLY: what gets mounted at /host (default: the whole C: drive).
# Narrow it if you don't want the whole drive, e.g. HOST_DRIVE=C:/Users/<user>
# HOST_DRIVE=C:/

# --- LiteLLM ----------------------------------------------------------------
# LiteLLM proxy key. Any random string - it stays on the compose network.
LITELLM_MASTER_KEY=sk-harness-local-change-me
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# --- Claude Code ------------------------------------------------------------
CLAUDE_CODE_VERSION=latest
# Playwright in the image (playwright-cli + browser): ~700 MB. 0 = build without it.
INSTALL_PLAYWRIGHT=1
# Playwright browser (for the image and browserName in ~/.playwright/cli.config.json).
PLAYWRIGHT_BROWSER=chromium
# Inherit the Claude Code config from the host (~/.claude): skills, agents,
# commands, CLAUDE.md and permissions/env from settings.json. 0 = clean container
# (only the harness's claude/config/). Details: docs/en/claude-configuration.md
HARNESS_INHERIT_HOST_CONFIG=1
# Stop LiteLLM and the router after the last session ends, if a session started them
# (services started with `./bin/harness up` keep running). 0 = leave them running.
HARNESS_AUTO_STOP=1
# A different host config directory (default ~/.claude; Windows: C:/Users/<user>/.claude).
# HOST_CLAUDE_DIR=
# Router mode: empty = value from models.yaml (hybrid).
# HARNESS_MODE=standalone
# HARNESS_LOG_LEVEL=debug
# Required ONLY in standalone mode (no Anthropic subscription) - any string.
# ANTHROPIC_AUTH_TOKEN=harness-standalone

# --- model provider keys (names from api_key_env in models.yaml) ------------
# Only the LiteLLM container can see them.
ZAI_API_KEY=
# DASHSCOPE_API_KEY=
# OPENROUTER_API_KEY=
